# Copy this file to .env and fill in your values

# ── Security ──────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# ── Email delivery (SMTP) ─────────────────────────────────────────────────
# Leave SMTP_HOST blank to run in dev mode (OTP shown on-screen, no email sent)
# Gmail: enable 2FA → generate App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Duo Queue <you@gmail.com>

# ── Database ───────────────────────────────────────────────────────────────
# Leave blank to use SQLite locally (./duoqueue.db)
# Railway sets this automatically when you add a Postgres plugin
# DATABASE_URL=postgresql://user:password@host:5432/dbname
